pipeline {
    agent 'any' 

    tools {
        maven 'maven1'
    }

    environment {
        my_aws_credential = credentials('aws-cred')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/RashiIngale03/edublitz-b2b-medical-erp.git'
            }
        }
        stage('Build User-service'){
            steps{
                dir('user-service'){
                    sh 'mvn clean package -DskipTests'
                }
                post{
                    success{
                        archiveArticats artifacts: 'user-service/target/*.jar', fingerprint: true
                    }
                }
            }
        }

    }
}   

